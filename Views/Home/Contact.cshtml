@{
    ViewData["Title"] = "Contact Us";
}

<div class="bg-success text-white py-5 mb-5 text-center fade-in-up">
    <div class="container">
        <h1 class="display-5 fw-bold">Contact Us</h1>
        <p class="lead mb-0">We are here to help you on your healing journey.</p>
    </div>
</div>

<div class="container mb-5 fade-in-up">
    <div class="row g-5">
        <div class="col-lg-5">
            <h3 class="fw-bold mb-4">Get In Touch</h3>
            <p class="text-muted mb-5">Have a question about our therapies or need help booking an appointment? Feel free to contact us.</p>
            
            <div class="d-flex align-items-center mb-4">
                <div class="icon-box mb-0 me-4" style="width: 50px; height: 50px; font-size: 20px;">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Main Branch</h5>
                    <p class="text-muted mb-0">DR Complex, City Enclave, near Anand Complex, Godown Area, Zirakpur, Punjab 140603</p>
                </div>
            </div>

            <div class="d-flex align-items-center mb-4">
                <div class="icon-box mb-0 me-4" style="width: 50px; height: 50px; font-size: 20px;">
                    <i class="fa-solid fa-phone"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Call Us</h5>
                    <p class="text-muted mb-0">+91 77777 77777</p>
                </div>
            </div>

            <div class="d-flex align-items-center mb-4">
                <div class="icon-box mb-0 me-4" style="width: 50px; height: 50px; font-size: 20px;">
                    <i class="fa-solid fa-envelope"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Email Us</h5>
                    <p class="text-muted mb-0">care@jeenasikho.com</p>
                </div>
            </div>
        </div>
        
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4">
                <h3 class="fw-bold mb-4 text-center">Send a Message</h3>
                <form>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Your Name</label>
                            <input type="text" class="form-control form-control-lg" placeholder="John Doe">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Your Email</label>
                            <input type="email" class="form-control form-control-lg" placeholder="john@example.com">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Subject</label>
                            <input type="text" class="form-control form-control-lg" placeholder="Inquiry about Panchakarma">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Message</label>
                            <textarea class="form-control form-control-lg" rows="4" placeholder="How can we help you?"></textarea>
                        </div>
                        <div class="col-12 mt-4 text-center">
                            <button type="button" class="btn btn-success btn-lg rounded-pill px-5 w-100" onclick="alert('Message sent feature will be connected to DB later. Please use Book Appointment for now.')">Send Message</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
