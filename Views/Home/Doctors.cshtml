@model IEnumerable<AyurvedaClinic.Models.Doctor>
@{
    ViewData["Title"] = "Our Experts";
}

<div class="bg-success text-white py-5 mb-5 text-center fade-in-up">
    <div class="container">
        <h1 class="display-5 fw-bold">Our Experts</h1>
        <p class="lead mb-0">Meet our experienced Ayurvedic practitioners and specialists.</p>
    </div>
</div>

<div class="container mb-5 fade-in-up">
    <div class="row g-4 justify-content-center">
        @if(Model != null && Model.Any())
        {
            foreach (var doctor in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card treatment-card h-100 border-0 shadow-sm overflow-hidden text-center">
                        <!-- Static Placeholder -->
                        <img src="https://via.placeholder.com/400x300?text=Doctor+Profile" class="card-img-top" alt="@doctor.Name">
                        <div class="card-body p-4">
                            <h4 class="fw-bold text-success mb-1">@doctor.Name</h4>
                            <h6 class="text-muted mb-3">@doctor.Specialization</h6>
                            <p class="text-muted small mb-4">@doctor.Bio</p>
                            <a asp-action="BookAppointment" class="btn btn-outline-success rounded-pill px-4">Consult Now</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">No doctors are currently available.</p>
            </div>
        }
    </div>
</div>
