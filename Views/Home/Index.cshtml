@model IEnumerable<AyurvedaClinic.Models.Service>
@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section class="hero-section text-center position-relative fade-in-up">
    <div class="container">
        <h1 class="display-4 fw-bold text-success mb-3">Panchakarma Treatment for Detox & Ayurvedic Healing</h1>
        <p class="lead text-muted mb-4 mx-auto" style="max-width: 700px;">
            Known since ancient ages for its traditional Ayurvedic detoxification and reversal of disease, our powerful therapies help eliminate deep-seated toxins and balance the three Doshas (Vata, Pitta, Kapha).
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-action="BookAppointment" class="btn btn-success btn-lg rounded-pill px-5 shadow">Start Your Healing Journey</a>
            <a asp-action="Treatments" class="btn btn-outline-success btn-lg rounded-pill px-5">Explore Therapies</a>
        </div>
    </div>
</section>

<!-- About Section -->
<section class="py-5 mt-5 fade-in-up">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <!-- Static Placeholder Image -->
                <img src="https://cdn.pixabay.com/photo/2024/03/20/04/00/ai-generated-8644566_960_720.jpg" alt="Ayurveda Healing" class="img-fluid rounded-4 shadow" loading="lazy" />
            </div>
            <div class="col-lg-6 px-lg-5">
                <h6 class="text-success fw-bold text-uppercase mb-2">About HIIMS</h6>
                <h2 class="fw-bold mb-4">Empowering You to Become Your Own Doctor</h2>
                <p class="text-muted mb-4">
                    Under the guidance of Acharya Manish Ji, Jeena Sikho HiiMS is committed to addressing the root causes of illness through Ayurvedic and Natural therapies. With a team of skilled medical professionals, we ensure that people receive care that completely supports their well-being.
                </p>
                <ul class="list-unstyled mb-4">
                    <li class="mb-2"><i class="fa-solid fa-circle-check text-success me-2"></i> Comprehensive Diagnosis & Holistic Treatments</li>
                    <li class="mb-2"><i class="fa-solid fa-circle-check text-success me-2"></i> Therapeutic Learning & Lifestyle Modifications</li>
                    <li class="mb-2"><i class="fa-solid fa-circle-check text-success me-2"></i> Personalized DIP Diet Plans</li>
                </ul>
                <a asp-action="Doctors" class="btn btn-success rounded-pill px-4">Meet Our Experts</a>
            </div>
        </div>
    </div>
</section>

<!-- Featured Therapies Section -->
<section class="py-5 bg-light fade-in-up">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="text-success fw-bold text-uppercase mb-2">Our Services</h6>
            <h2 class="fw-bold">Panchakarma Therapies</h2>
            <p class="text-muted">Purification process by five therapies to detoxify the complete body.</p>
        </div>
        <div class="row g-4">
            @foreach(var item in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card treatment-card h-100 p-4">
                        <div class="icon-box">
                            <i class="@item.IconClass"></i>
                        </div>
                        <h4 class="fw-bold mb-3">@item.Title</h4>
                        <p class="text-muted mb-0">@item.Description</p>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a asp-action="Treatments" class="btn btn-outline-success rounded-pill px-4">View All Therapies</a>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="py-5 mt-5 mb-5 text-center text-white rounded-4 shadow fade-in-up" style="background: linear-gradient(135deg, #198754 0%, #0f5132 100%);">
    <div class="container py-4">
        <h2 class="fw-bold mb-3">Ready to Transform Your Health?</h2>
        <p class="lead mb-4 mx-auto" style="max-width: 600px;">Book your appointment today and take the first step towards a drug-free and disease-free life with Jeena Sikho HiiMS.</p>
        <a asp-action="BookAppointment" class="btn btn-light text-success btn-lg rounded-pill px-5 fw-bold shadow-sm">Book Appointment Now</a>
    </div>
</section>
