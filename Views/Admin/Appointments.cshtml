@model IEnumerable<AyurvedaClinic.Models.Appointment>
@{
    ViewData["Title"] = "Appointments";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <h1 class="h2 fw-bold text-success">Appointments</h1>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Patient Name</th>
                    <th>Phone</th>
                    <th>Treatment</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var appt in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-medium">@appt.AppointmentDate.ToString("dd MMM yyyy")</span>
                                <br />
                                <small class="text-muted">Booked: @appt.CreatedAt.ToString("dd MMM, HH:mm")</small>
                            </td>
                            <td class="fw-medium">@appt.Name</td>
                            <td>@appt.Phone</td>
                            <td><span class="badge bg-success bg-opacity-10 text-success">@appt.Treatment</span></td>
                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                            <td>
                                <form asp-action="DeleteAppointment" method="post" onsubmit="return confirm('Are you sure you want to delete this appointment?');" class="d-inline">
                                    <input type="hidden" name="id" value="@appt.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No appointments found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
