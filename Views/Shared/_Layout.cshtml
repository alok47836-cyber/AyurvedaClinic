<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="HIIMS Panchakarma provides authentic Ayurvedic treatments, detoxification, and holistic healing under the guidance of Acharya Manish Ji." />
    <meta name="keywords" content="Ayurveda, Panchakarma, Vamana, Virechana, Detox, HIIMS, Acharya Manish Ji, Natural Healing" />
    <meta property="og:title" content="@ViewData["Title"] - HIIMS Panchakarma" />
    <meta property="og:description" content="HIIMS Panchakarma provides authentic Ayurvedic treatments, detoxification, and holistic healing." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hiims.in/panchakarma" />
    <title>@ViewData["Title"] - HIIMS Panchakarma</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">
                <a class="navbar-brand text-success fw-bold fs-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-leaf me-2"></i>HIIMS Panchakarma
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-toggle="target" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto fw-medium">
                        <li class="nav-item">
                            <a class="nav-link text-dark mx-2" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark mx-2" asp-area="" asp-controller="Home" asp-action="Treatments">Treatments</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark mx-2" asp-area="" asp-controller="Home" asp-action="Doctors">Doctors</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark mx-2" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary mx-2" asp-area="" asp-controller="Admin" asp-action="Index">Admin Panel</a>
                            </li>
                        }
                    </ul>
                    <a class="btn btn-success rounded-pill px-4 ms-lg-3 mt-3 mt-lg-0 shadow-sm" asp-controller="Home" asp-action="BookAppointment">Book Appointment</a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-success fw-bold mb-3"><i class="fa-solid fa-leaf me-2"></i>HIIMS Panchakarma</h5>
                    <p class="text-muted">Under the guidance of Acharya Manish Ji, we provide holistic healing with traditional Ayurveda and Naturopathy.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5 class="fw-bold mb-3">Quick Links</h5>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Home</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">About Us</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Treatments</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3">Therapies</h5>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>Vamana</li>
                        <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>Virechana</li>
                        <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>Basti</li>
                        <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>Nasya</li>
                        <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>Raktmokshana</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold mb-3">Contact Us</h5>
                    <p class="text-muted mb-2"><i class="fa-solid fa-phone text-success me-2"></i> +91 82704 82704</p>
                    <p class="text-muted mb-2"><i class="fa-solid fa-envelope text-success me-2"></i> care@jeenasikho.com</p>
                    <p class="text-muted mb-0"><i class="fa-solid fa-location-dot text-success me-2"></i> Zirakpur, Punjab 140603</p>
                </div>
            </div>
            <hr class="border-secondary mt-4 mb-3" />
            <div class="text-center text-muted small">
                &copy; @DateTime.Now.Year - HIIMS Panchakarma. All Rights Reserved.
            </div>
        </div>
    </footer>

    <!-- WhatsApp Floating Button -->
    <a href="https://wa.me/918270482704?text=Hello,%20I%20want%20to%20book%20an%20appointment." class="whatsapp-float shadow" target="_blank">
        <i class="fa-brands fa-whatsapp my-float"></i>
    </a>

    <!-- jQuery and Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
